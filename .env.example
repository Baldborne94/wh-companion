VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# YouTube OAuth (Google Cloud Console → Credenziali → OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Server-side only (Vercel env vars, NO "VITE_" prefix — never bundled to the client) ──
# Used by api/paint-advisor.js (AI Color Advisor proxy, 3 uses/day per user).
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_URL and SUPABASE_ANON_KEY are optional (the proxy falls back to the VITE_ ones)
